generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String?
  role        String   @default("student")
  phoneNumber String
  createdAt   DateTime @default(now())

  enrollments      Enrollment[]
  progress         Progress[]
  payments         Payment[]
  passwordResetTokens PasswordResetToken[]
  studentPayments  StudentPayment[]
  deviceTokens     DeviceToken[]
  notificationLogs NotificationLog[]

  cart   Cart?
  orders Order[]

  enrolledCourseIds String[]

  assignedCoupons Coupon[] @relation("UserCoupons")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// COURSE
//////////////////////////////////////////////////////

enum PaymentMode {
  INSTALLMENT
  FULL_PAYMENT
}

model Course {
  id           String      @id @default(uuid())
  title        String
  description  String?
  thumbnail    String?
  price        Decimal     @db.Decimal(10, 2)
  published    Boolean     @default(false)
  isVisible    Boolean     @default(true)
  instructorId String
  paymentMode  PaymentMode @default(INSTALLMENT)

  startDate          DateTime?
  endDate            DateTime?
  accessDurationDays Int?

  s3Key     String?
  s3Bucket  String?
  mediaType String?

  sections        Section[]
  enrollments     Enrollment[]
  payments        Payment[]
  paymentPlans    CoursePaymentPlan[]
  studentPayments StudentPayment[]
  courseResources CourseResource[]
  liveClasses     LiveClass[]
}

model CoursePaymentPlan {
  id           String  @id @default(uuid())
  courseId     String
  stageName    String
  description  String?
  amount       Decimal @db.Decimal(10, 2)
  dueAfterDays Int     @default(0)
  orderIndex   Int

  startDate DateTime?
  endDate   DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

enum ResourceType {
  FREE
  PAID
}

model CourseResource {
  id        String       @id @default(uuid())
  courseId  String
  title     String
  s3Key     String
  s3Bucket  String
  type      ResourceType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Section {
  id         String @id @default(uuid())
  title      String
  courseId   String
  orderIndex Int    @default(1)

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures    Lecture[]
  liveClasses LiveClass[]

  @@index([courseId, orderIndex])
}

model Lecture {
  id        String @id @default(uuid())
  title     String
  videoUrl  String
  sectionId String

  section  Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress Progress[]

  videoProvider String? @default("cloudinary")
  muxAssetId    String?
  muxPlaybackId String?
  muxReady      Boolean @default(false)

  s3Key    String?
  s3Bucket String?
}

//////////////////////////////////////////////////////
// ENROLLMENT
//////////////////////////////////////////////////////

enum EnrollmentStatus {
  ACTIVE
  PAYMENT_DUE
  COMPLETED
  CANCELLED
}

model Enrollment {
  id           String           @id @default(uuid())
  userId       String
  courseId     String
  serialNumber String?
  status       EnrollmentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  expiresAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

//////////////////////////////////////////////////////
// STUDENT PAYMENTS
//////////////////////////////////////////////////////

enum StudentPaymentStatus {
  PENDING
  PAID
  FAILED
  OVERDUE
}

model StudentPayment {
  id        String  @id @default(uuid())
  userId    String
  courseId  String
  planId    String?
  stageName String
  amount    Decimal @db.Decimal(10, 2)

  razorpayOrderId   String?
  razorpayPaymentId String?

  status StudentPaymentStatus @default(PENDING)

  dueDate DateTime?
  paidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([status])
}

//////////////////////////////////////////////////////
// PROGRESS
//////////////////////////////////////////////////////

model Progress {
  id        String  @id @default(uuid())
  userId    String
  lectureId String
  completed Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  COURSE
  PRODUCT
}

enum PaymentProvider {
  RAZORPAY
}

model Payment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type PaymentType

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  status   PaymentStatus   @default(PENDING)
  provider PaymentProvider

  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?

  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

//////////////////////////////////////////////////////
// LIVE CLASSES
//////////////////////////////////////////////////////

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

model LiveClass {
  id        String  @id @default(uuid())
  courseId  String
  sectionId String?

  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  meetingUrl      String
  recordingUrl    String?
  status          LiveClassStatus @default(SCHEDULED)

  notifySent          Boolean @default(false)
  recordingNotifySent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([scheduledAt])
}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
}

model NotificationLog {
  id          String    @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String
  data        String?
  liveClassId String?
  sent        Boolean   @default(false)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

//////////////////////////////////////////////////////
// E-COMMERCE
//////////////////////////////////////////////////////

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([name])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  image       String?
  price       Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  isActive    Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
  cartItems  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subtotalAmount Decimal @db.Decimal(10, 2) @default(0)
  bulkDiscount   Decimal @db.Decimal(10, 2) @default(0)
  couponDiscount Decimal @db.Decimal(10, 2) @default(0)
  totalAmount    Decimal @db.Decimal(10, 2)
  status         OrderStatus @default(PENDING)

  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingPostal  String

  couponId    String?
  coupon      Coupon?      @relation("OrderCoupon", fields: [couponId], references: [id])
  couponUsage CouponUsage?

  payment Payment?
  items   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

//////////////////////////////////////////////////////
// DISCOUNT / COUPONS
//////////////////////////////////////////////////////

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum BulkTierType {
  QUANTITY
  VALUE
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  maxUses       Int
  usedCount     Int          @default(0)
  expiresAt     DateTime
  isActive      Boolean      @default(true)

  assignedUserId String
  assignedUser   User         @relation("UserCoupons", fields: [assignedUserId], references: [id], onDelete: Cascade)

  orders Order[]      @relation("OrderCoupon")
  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([assignedUserId])
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  orderId  String   @unique
  userId   String
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model BulkDiscountTier {
  id              String       @id @default(uuid())
  type            BulkTierType
  minThreshold    Decimal      @db.Decimal(10, 2)
  discountPercent Decimal      @db.Decimal(5, 2)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([type, isActive])
}
