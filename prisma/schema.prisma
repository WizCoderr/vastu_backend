generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String?
  role      String   @default("student")
  phoneNumber String
  createdAt DateTime @default(now())

  enrollments      Enrollment[]
  progress         Progress[]
  payments         Payment[]
  studentPayments  StudentPayment[]
  deviceTokens     DeviceToken[]
  notificationLogs NotificationLog[]

  // E-commerce
  cart   Cart?
  orders Order[]

  enrolledCourseIds String[] @default([])
}

//////////////////////////////////////////////////////
// COURSE (LMS)
//////////////////////////////////////////////////////

model Course {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  thumbnail    String?
  price        String
  published    Boolean @default(false)
  isVisible    Boolean @default(true)
  instructorId String

  startDate    DateTime?
  endDate      DateTime?

  s3Key     String?
  s3Bucket  String?
  mediaType String?

  sections        Section[]
  enrollments     Enrollment[]
  payments        Payment[]
  paymentPlans    CoursePaymentPlan[]
  studentPayments StudentPayment[]
  courseResources CourseResource[]
  liveClasses     LiveClass[]
}

enum ResourceType {
  FREE
  PAID
}

model CourseResource {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  courseId  String       @db.ObjectId
  title     String
  s3Key     String
  s3Bucket  String
  type      ResourceType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  course    Course       @relation(fields: [courseId], references: [id])
}

model Section {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  courseId  String    @db.ObjectId

  course    Course    @relation(fields: [courseId], references: [id])
  lectures  Lecture[]
  liveClasses LiveClass[]
}

model Lecture {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  videoUrl  String
  sectionId String     @db.ObjectId

  section   Section    @relation(fields: [sectionId], references: [id])
  progress  Progress[]

  videoProvider String? @default("cloudinary")
  muxAssetId    String?
  muxPlaybackId String?
  muxReady      Boolean @default(false)

  s3Key    String?
  s3Bucket String?
}

model Enrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  courseId  String   @db.ObjectId
  serialNumber String?
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

enum EnrollmentStatus {
  ACTIVE
  PAYMENT_DUE
  COMPLETED
  CANCELLED
}

model CoursePaymentPlan {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  courseId       String @db.ObjectId
  stageName      String
  amount         Float
  dueAfterDays   Int    @default(0)
  orderIndex     Int

  course         Course @relation(fields: [courseId], references: [id])
  
  @@index([courseId])
}

model StudentPayment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  courseId        String   @db.ObjectId
  planId          String?  @db.ObjectId
  stageName       String
  amount          Float
  
  razorpayOrderId   String?
  razorpayPaymentId String?
  
  status          StudentPaymentStatus @default(PENDING)
  
  dueDate         DateTime?
  paidAt          DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
  course          Course   @relation(fields: [courseId], references: [id])
  
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

enum StudentPaymentStatus {
  PENDING
  PAID
  FAILED
  OVERDUE
}

model Progress {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  lectureId String  @db.ObjectId
  completed Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id])
  lecture Lecture @relation(fields: [lectureId], references: [id])

  @@unique([userId, lectureId])
}

//////////////////////////////////////////////////////
// PAYMENT (UNIFIED LMS + ECOMMERCE)
//////////////////////////////////////////////////////

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  COURSE
  PRODUCT
}

enum PaymentProvider {
  RAZORPAY
}

model Payment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])

  type      PaymentType

  // COURSE PAYMENT (1:1)
  courseId  String?  @unique @db.ObjectId
  course    Course?  @relation(fields: [courseId], references: [id])

  // ORDER PAYMENT (1:1)
  orderId   String?  @unique @db.ObjectId
  order     Order?   @relation(fields: [orderId], references: [id])

  amount    Float
  currency  String   @default("INR")

  status    PaymentStatus @default(PENDING)
  provider  PaymentProvider

  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?

  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

//////////////////////////////////////////////////////
// LIVE CLASSES
//////////////////////////////////////////////////////

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

model LiveClass {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String          @db.ObjectId
  sectionId   String?         @db.ObjectId

  title       String
  description String?
  scheduledAt DateTime
  durationMinutes Int @default(60)
  meetingUrl  String
  recordingUrl String?
  status      LiveClassStatus @default(SCHEDULED)

  notifySent          Boolean @default(false)
  recordingNotifySent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course  @relation(fields: [courseId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@index([courseId])
  @@index([scheduledAt])
}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

model DeviceToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, token])
}

model NotificationLog {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  type        String
  title       String
  body        String
  data        String?
  liveClassId String?   @db.ObjectId
  sent        Boolean   @default(false)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
//////////////////////////////////////////////////////
// E-COMMERCE
//////////////////////////////////////////////////////

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([name])
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  image       String?
  price       Float
  stock       Int      @default(0)
  isActive    Boolean  @default(true)

  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])

  orderItems  OrderItem[]
  cartItems   CartItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model Cart {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  productId String   @db.ObjectId
  quantity  Int      @default(1)

  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id])

  totalAmount   Float
  status        OrderStatus @default(PENDING)

  shippingName      String
  shippingPhone     String
  shippingAddress   String
  shippingCity      String
  shippingState     String
  shippingPostal    String

  payment       Payment?
  items         OrderItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  productId String   @db.ObjectId

  quantity  Int
  price     Float

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}