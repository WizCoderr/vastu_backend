generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // native = local/dev; debian-openssl-3.0.x = Docker/VPS (apt Chromium image)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id          String   @id @default(uuid()) @map("_id")
  email       String   @unique
  password    String
  name        String?
  role        String   @default("student")
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments         Enrollment[]
  progress            Progress[]
  payments            Payment[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  studentPayments     StudentPayment[]
  deviceTokens        DeviceToken[]
  notificationLogs    NotificationLog[]

  cart         Cart?
  orders       Order[]
  walletPasses WalletPass[]

  enrolledCourseIds String[]

  assignedCoupons Coupon[]      @relation("UserCoupons")
  couponGrants    CouponGrant[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

//////////////////////////////////////////////////////
// COURSE
//////////////////////////////////////////////////////

enum PaymentMode {
  INSTALLMENT
  FULL_PAYMENT
}

model Course {
  id           String      @id @default(uuid()) @map("_id")
  title        String
  description  String?
  thumbnail    String?
  price        Float
  published    Boolean     @default(false)
  isVisible    Boolean     @default(true)
  instructorId String
  paymentMode  PaymentMode @default(INSTALLMENT)

  startDate          DateTime?
  endDate            DateTime?
  accessDurationDays Int?

  s3Key     String?
  s3Bucket  String?
  mediaType String?

  sections        Section[]
  enrollments     Enrollment[]
  payments        Payment[]
  paymentPlans    CoursePaymentPlan[]
  studentPayments StudentPayment[]
  courseResources CourseResource[]
  liveClasses     LiveClass[]
}

model CoursePaymentPlan {
  id           String  @id @default(uuid()) @map("_id")
  courseId     String
  stageName    String
  description  String?
  amount       Float
  dueAfterDays Int     @default(0)
  orderIndex   Int

  startDate DateTime?
  endDate   DateTime?

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

enum ResourceType {
  FREE
  PAID
}

model CourseResource {
  id        String       @id @default(uuid()) @map("_id")
  courseId  String
  title     String
  s3Key     String
  s3Bucket  String
  type      ResourceType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id])
}

model Section {
  id         String @id @default(uuid()) @map("_id")
  title      String
  courseId   String
  orderIndex Int    @default(1)

  course      Course      @relation(fields: [courseId], references: [id])
  lectures    Lecture[]
  liveClasses LiveClass[]

  @@index([courseId])
}

model Lecture {
  id        String @id @default(uuid()) @map("_id")
  title     String
  videoUrl  String
  sectionId String

  section  Section    @relation(fields: [sectionId], references: [id])
  progress Progress[]

  videoProvider String? @default("cloudinary")
  muxAssetId    String?
  muxPlaybackId String?
  muxReady      Boolean @default(false)

  s3Key    String?
  s3Bucket String?
}

//////////////////////////////////////////////////////
// ENROLLMENT
//////////////////////////////////////////////////////

enum EnrollmentStatus {
  ACTIVE
  PAYMENT_DUE
  COMPLETED
  CANCELLED
}

model Enrollment {
  id           String           @id @default(uuid()) @map("_id")
  userId       String
  courseId     String
  serialNumber String?
  status       EnrollmentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  expiresAt    DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

//////////////////////////////////////////////////////
// STUDENT PAYMENTS
//////////////////////////////////////////////////////

enum StudentPaymentStatus {
  PENDING
  PAID
  FAILED
  OVERDUE
}

model StudentPayment {
  id        String  @id @default(uuid()) @map("_id")
  userId    String
  courseId  String
  planId    String?
  stageName String
  amount    Float

  merchantTxnRef    String?
  utr               String?
  providerPaymentId String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  upiUrl            String?
  qrCodeBase64      String?
  providerResponse  Json?
  expiresAt         DateTime?
  verifiedAt        DateTime?

  status StudentPaymentStatus @default(PENDING)

  dueDate DateTime?
  paidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([merchantTxnRef])
  @@index([utr])
}

//////////////////////////////////////////////////////
// PROGRESS
//////////////////////////////////////////////////////

model Progress {
  id        String  @id @default(uuid()) @map("_id")
  userId    String
  lectureId String
  completed Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id])
  lecture Lecture @relation(fields: [lectureId], references: [id])

  @@unique([userId, lectureId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  COURSE
  PRODUCT
}

enum PaymentProvider {
  UPI
  RAZORPAY
  CASH
}

model Payment {
  id     String @id @default(uuid()) @map("_id")
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type PaymentType

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  amount      Float
  currency    String  @default("INR")
  description String?

  status   PaymentStatus   @default(PENDING)
  provider PaymentProvider

  merchantTxnRef    String?
  utr               String?
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  upiUrl            String?
  qrCodeBase64      String?
  providerResponse  Json?
  expiresAt         DateTime?
  verifiedAt        DateTime?

  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([merchantTxnRef])
  @@index([utr])
}

model Invoice {
  id            String   @id @default(uuid()) @map("_id")
  invoiceNumber String   @unique
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id])
  filePath      String
  publicUrl     String?
  createdAt     DateTime @default(now())
}

//////////////////////////////////////////////////////
// LIVE CLASSES
//////////////////////////////////////////////////////

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

model LiveClass {
  id        String  @id @default(uuid()) @map("_id")
  courseId  String
  sectionId String?

  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  meetingUrl      String
  recordingUrl    String?
  status          LiveClassStatus @default(SCHEDULED)

  notifySent          Boolean @default(false)
  recordingNotifySent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id])

  @@index([courseId])
  @@index([scheduledAt])
}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

model DeviceToken {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  token     String
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, token])
}

model NotificationLog {
  id          String    @id @default(uuid()) @map("_id")
  userId      String
  type        String
  title       String
  body        String
  data        String?
  liveClassId String?
  sent        Boolean   @default(false)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

//////////////////////////////////////////////////////
// E-COMMERCE
//////////////////////////////////////////////////////

model Category {
  id          String   @id @default(uuid()) @map("_id")
  name        String
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products         Product[]
  couponCategories CouponCategory[]

  @@index([name])
}

model Product {
  id                String  @id @default(uuid()) @map("_id")
  name              String
  description       String?
  images            Json    @default("[]")
  price             Float
  purchasePrice     Float?
  lastPurchasePrice Float?
  inventoryValue    Float   @default(0)
  stock             Int     @default(0)
  isActive          Boolean @default(true)

  lowStockThreshold   Int?
  lowStockAlertSentAt DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems     OrderItem[]
  cartItems      CartItem[]
  stockMovements StockMovement[]
  couponProducts CouponProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model StockSettings {
  id                      String   @id @default("default") @map("_id")
  globalLowStockThreshold Int      @default(5)
  updatedAt               DateTime @updatedAt
}

enum StockMovementType {
  ORDER
  RESTOCK
  ADJUSTMENT
  INITIAL
}

model StockMovement {
  id              String            @id @default(uuid()) @map("_id")
  productId       String
  type            StockMovementType
  quantityChange  Int
  previousStock   Int
  newStock        Int
  reason          String?
  referenceId     String?
  createdBy       String?
  unitCost        Float?
  previousAvgCost Float?
  newAvgCost      Float?
  createdAt       DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

enum WhatsAppNotificationType {
  NEW_ORDER
  LOW_STOCK
  ORDER_CONFIRMATION
  ORDER_STATUS
  COUPON_GRANT
}

enum WhatsAppNotificationStatus {
  PENDING
  SENT
  FAILED
  FALLBACK_LINK
}

model WhatsAppNotification {
  id             String                     @id @default(uuid()) @map("_id")
  type           WhatsAppNotificationType
  recipientPhone String
  message        String
  status         WhatsAppNotificationStatus @default(PENDING)
  waMeUrl        String?
  referenceId    String?
  error          String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())

  @@index([status])
  @@index([createdAt])
}

model Cart {
  id        String     @id @default(uuid()) @map("_id")
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(uuid()) @map("_id")
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id     String @id @default(uuid()) @map("_id")
  userId String
  user   User   @relation(fields: [userId], references: [id])

  subtotalAmount Float  @default(0)
  bulkDiscount   Float  @default(0)
  couponDiscount Float  @default(0)
  shippingCost   Float? @default(0)
  totalAmount    Float
  status         OrderStatus @default(PENDING)

  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingPostal  String

  couponId    String?
  coupon      Coupon?      @relation("OrderCoupon", fields: [couponId], references: [id])
  couponUsage CouponUsage?

  payment    Payment?
  items      OrderItem[]
  walletPass WalletPass?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(uuid()) @map("_id")
  orderId        String
  productId      String
  quantity       Int
  price          Float
  unitCostAtSale Float?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

//////////////////////////////////////////////////////
// DISCOUNT / COUPONS
//////////////////////////////////////////////////////

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum BulkTierType {
  QUANTITY
  VALUE
}

enum CouponProductScope {
  ALL
  SPECIFIC
  CATEGORY
}

enum CouponGrantStatus {
  ACTIVE
  REDEEMED
  REVOKED
}

model Coupon {
  id            String             @id @default(uuid()) @map("_id")
  code          String             @unique
  name          String?
  description   String?
  discountType  DiscountType
  discountValue Float
  maxUses       Int
  usedCount     Int                @default(0)
  expiresAt     DateTime?
  isActive      Boolean            @default(true)
  productScope  CouponProductScope @default(ALL)
  requiresGrant Boolean            @default(false)

  assignedUserId String?
  assignedUser   User?   @relation("UserCoupons", fields: [assignedUserId], references: [id])

  orders     Order[]          @relation("OrderCoupon")
  usages     CouponUsage[]
  products   CouponProduct[]
  categories CouponCategory[]
  grants     CouponGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedUserId])
}

model CouponGrant {
  id         String            @id @default(uuid()) @map("_id")
  couponId   String
  userId     String
  status     CouponGrantStatus @default(ACTIVE)
  grantedAt  DateTime          @default(now())
  redeemedAt DateTime?
  orderId    String?

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

model CouponProduct {
  id        String  @id @default(uuid()) @map("_id")
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@unique([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  id            String   @id @default(uuid()) @map("_id")
  couponId      String
  categoryId    String
  discountValue Float
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  category      Category @relation(fields: [categoryId], references: [id])

  @@unique([couponId, categoryId])
  @@index([categoryId])
}

model CouponUsage {
  id       String   @id @default(uuid()) @map("_id")
  couponId String
  orderId  String   @unique
  userId   String
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([userId])
}

model BulkDiscountTier {
  id              String       @id @default(uuid()) @map("_id")
  type            BulkTierType
  minThreshold    Float
  discountPercent Float
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([type])
  @@index([isActive])
}

//////////////////////////////////////////////////////
// GOOGLE WALLET — ORDER RECEIPTS
//////////////////////////////////////////////////////

enum WalletPassType {
  ORDER_RECEIPT
}

enum WalletPassStatus {
  PENDING
  ACTIVE
  INACTIVE
  EXPIRED
}

model WalletPass {
  id                   String           @id @default(uuid()) @map("_id")
  userId               String
  orderId              String           @unique
  googleWalletClassId  String?
  googleWalletObjectId String?
  passType             WalletPassType   @default(ORDER_RECEIPT)
  status               WalletPassStatus @default(PENDING)
  passData             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user   User          @relation(fields: [userId], references: [id])
  order  Order         @relation(fields: [orderId], references: [id])
  events WalletEvent[]

  @@index([userId])
  @@index([status])
  @@index([googleWalletObjectId])
}

model WalletEvent {
  id           String   @id @default(uuid()) @map("_id")
  walletPassId String
  eventType    String
  eventData    Json?
  createdAt    DateTime @default(now())

  walletPass WalletPass @relation(fields: [walletPassId], references: [id])

  @@index([walletPassId])
  @@index([createdAt])
}
