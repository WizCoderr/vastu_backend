# Stack deploy env — copy to deploy/.env
IMAGE_TAG=latest
VITE_API_BASE_URL=https://api.vastuarunsharma.com
WORKER_WHATSAPP_ENABLED=false
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
SSL_CERT_DIR=./nginx/certs

# Telegram — set in ../.env (vastu_backend/.env):
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_ADMIN_CHAT_ID=...

# DATABASE_URL and secrets live in ../.env (vastu_backend/.env)

# Rate limiting (optional overrides; defaults shown) — set in ../.env:
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_AUTH_LOGIN_MAX=10
# RATE_LIMIT_AUTH_PASSWORD_RESET_MAX=5
# RATE_LIMIT_PAYMENT_CREATE_MAX=20
# RATE_LIMIT_PAYMENT_VERIFY_MAX=30
# RATE_LIMIT_WEBHOOK_MAX=120
# RATE_LIMIT_PUBLIC_MAX=120
# RATE_LIMIT_GLOBAL_MAX=300
