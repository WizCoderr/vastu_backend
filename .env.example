# Server
PORT=3030
NODE_ENV=development
JWT_SECRET=change-me

# MongoDB (Prisma 6.19 + provider=mongodb)
# Include database name in the path, e.g. /vastu
DATABASE_URL="mongodb+srv://USER:PASSWORD@vastucluster.pffndcv.mongodb.net/vastu?retryWrites=true&w=majority"

# Payments — Razorpay (default)
PAYMENT_PROVIDER=razorpay
RAZORPAY_USE_TEST=true
# Test keys (when RAZORPAY_USE_TEST=true)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Or alias:
# RAZORPAY_TEST_KEY_ID=
# RAZORPAY_TEST_KEY_SECRET=
# Live keys (when RAZORPAY_USE_TEST=false)
RAZORPAY_KEY_ID_PROD=
RAZORPAY_KEY_SECRET_PROD=
# Dashboard → Webhooks → Secret (POST /api/payments/webhook/razorpay)
RAZORPAY_WEBHOOK_SECRET=

REDIS_ENABLED=false
RUN_PAYMENT_WORKERS=false

# Google Wallet
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_SUFFIX=vastu_order_receipt
GOOGLE_WALLET_ORIGINS=https://vastuarunsharma.com,https://www.vastuarunsharma.com,http://localhost:5173
GOOGLE_WALLET_USE_MOCK=false
