# Server
PORT=3030
NODE_ENV=development
JWT_SECRET=change-me
DATABASE_URL=mongodb://localhost:27017/vastu

# Payment provider: payu | upi
PAYMENT_PROVIDER=payu

# PayU — test mode when PAYU_USE_TEST is anything other than the literal string "false"
PAYU_USE_TEST=true
# Preferred test keys (PayU Dashboard → Test Mode → Developer → API Keys)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MERCHANT_SALT_V2=
# Aliases accepted by config (same values as above)
PAYU_TEST_MERCHANT_KEY=
PAYU_TEST_MERCHANT_SALT=
PAYU_TEST_MERCHANT_SALT_V2=
# Production keys (used only when PAYU_USE_TEST=false) — set on the VPS .env, never commit
PAYU_MERCHANT_KEY_PROD=
PAYU_MERCHANT_SALT_PROD=
PAYU_MERCHANT_SALT_V2_PROD=
# Public API base PayU redirects to (surl/furl) — must be internet-reachable
PAYU_PUBLIC_API_URL=http://localhost:3030
# SPA origin to 302 after PayU callback (web) / unused HTML ack for app
PAYU_WEB_RETURN_URL=http://localhost:5173

# Legacy UPI (only when PAYMENT_PROVIDER=upi)
UPI_MERCHANT_VPA=
UPI_MERCHANT_NAME=
PAYMENT_BANK_PROVIDER=mock
BANK_API_KEY=
BANK_API_SECRET=
BANK_MERCHANT_ID=
BANK_BASE_URL=
UPI_PAYMENT_EXPIRY_MINUTES=30
INVOICE_BASE_URL=http://localhost:3030

# Redis / workers (optional for PayU)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
PROCESS_ROLE=all
RUN_PAYMENT_WORKERS=false

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vastuarunsharma.com

# WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_ADMIN_PHONE=

# Google Wallet (optional post-payment receipt)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
