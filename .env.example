# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL=mongodb+srv://USER:PASS@HOST/DB?retryWrites=true&w=majority

# Server
PORT=3030
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
WORKERS=1
FORCE_CLUSTER=false
LOG_LEVEL=info

# Auth
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_OTP_TTL_MINUTES=10

# Payments (PayU)
PAYMENT_PROVIDER=payu
PAYU_USE_TEST=true
PAYU_MERCHANT_KEY_PROD=replace_me
PAYU_MERCHANT_SALT_PROD=replace_me
PAYU_MERCHANT_SALT_V2_PROD=replace_me
PAYU_PUBLIC_API_URL=http://localhost:3030
PAYU_WEB_RETURN_URL=http://localhost:3000

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Notifications / messaging
ENABLE_NOTIFICATION_WORKER=false
NOTIFICATION_WORKER_INTERVAL=5
NOTIFY_BEFORE_MINUTES=30
MEETING_URL_WINDOW_MINUTES=15
FCM_SERVER_KEY=
WHATSAPP_ENABLED=false
WHATSAPP_ADMIN_PHONE=
WHATSAPP_SESSION_PATH=.wwebjs_auth
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Media / cloud
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=

# Optional: PG→Mongo migration source only
POSTGRES_URL=
